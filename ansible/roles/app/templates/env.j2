# {{ ansible_managed }}
# Vrijednosti za app/compose.yaml, iz plan-adresa.yaml. Lozinka nije ovdje (secrets/db_password).
APP_VERZIJA={{ app_verzija }}
ZONA={{ zona }}
DNS_SERVER={{ vm.ns1.ip }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
SEG_WEB_SUBNET={{ segmenti.web.podmreza }}
SEG_APP_SUBNET={{ segmenti.app.podmreza }}
SEG_DB_SUBNET={{ segmenti.db.podmreza }}
FRONTEND_WEB_IP={{ kontejneri.frontend.adrese.web }}
FRONTEND_APP_IP={{ kontejneri.frontend.adrese.app }}
BACKEND_APP_IP={{ kontejneri.backend.adrese.app }}
BACKEND_DB_IP={{ kontejneri.backend.adrese.db }}
DB_DB_IP={{ kontejneri.db.adrese.db }}
